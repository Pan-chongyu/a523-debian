/dts-v1/;
#include "sun55i-a523.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
    model = "TZX P30A523-56T5G-240321 bring-up";
    compatible = "tzx,p30a523", "allwinner,sun55i-a523";
    aliases {
        serial0 = &uart0;
        mmc0 = &mmc2;
        mmc1 = &mmc1;
        i2c0 = &r_i2c0;
        i2c1 = &touch_i2c;
    };
    chosen {
        stdout-path = "serial0:115200n8";
        bootargs = "console=tty0 console=ttyS0,115200 earlycon=uart8250,mmio32,0x02500000,115200 loglevel=8 ignore_loglevel clk_ignore_unused regulator_ignore_unused rdinit=/init panic=5";
        linux,initrd-start = <0x0 0x60000000>;
        linux,initrd-end = <0x0 0x61000000>;
    };
    /* 4096 MiB reported by training; the ARM64 entry verified distinct
     * addresses at all sixteen 256-MiB boundaries on this board. */
    memory@40000000 {
        device_type = "memory";
        reg = <0x0 0x40000000 0x1 0x00000000>;
    };
    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;
        ramoops@43000000 {
            compatible = "ramoops";
            reg = <0x0 0x43000000 0x0 0x100000>;
            record-size = <0x20000>;
            console-size = <0x80000>;
            pmsg-size = <0x20000>;
        };
    };
    /* Fixed descriptions of the currently powered eMMC rails. These nodes
     * have no GPIO/PMIC control and do not alter the existing rail settings. */
    emmc_vcc: regulator-emmc-vcc {
        compatible = "regulator-fixed";
        regulator-name = "emmc-vcc";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        regulator-always-on;
    };
    emmc_vccq: regulator-emmc-vccq {
        compatible = "regulator-fixed";
        regulator-name = "emmc-vccq";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        regulator-always-on;
    };
    /* GPIO I2C on the verified PH0/PH1 wires was used for the paged firmware
     * test. Hardware I2C writes need retesting with the corrected reset
     * sequence; errors with the old sequence did not prove a bus fault. */
    touch_i2c: touch-i2c {
        compatible = "i2c-gpio";
        sda-gpios = <&pio 7 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
        scl-gpios = <&pio 7 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
        i2c-gpio,delay-us = <10>;
        #address-cells = <1>;
        #size-cells = <0>;
        touchscreen@40 {
            compatible = "tzx,p30-gsl3670-candidate";
            reg = <0x40>;
            interrupt-parent = <&pio>;
            interrupts = <7 9 IRQ_TYPE_EDGE_RISING>;
            power-gpios = <&pio 7 10 GPIO_ACTIVE_HIGH>;
            avdd-supply = <&reg_cldo2>;
            firmware-name = "silead/tzx-p30-candidate.fw";
            /* Provisional ranges from this candidate firmware. */
            touchscreen-size-x = <1648>;
            touchscreen-size-y = <880>;
            touchscreen-swapped-x-y;
            touchscreen-inverted-y;
        };
    };
    wifi_pwrseq: wifi-pwrseq {
        compatible = "mmc-pwrseq-simple";
        reset-gpios = <&r_pio 1 1 GPIO_ACTIVE_LOW>; /* R_PIO banks: PL=0, PM=1 */
        post-power-on-delay-ms = <300>;
    };
};

&mmc2 {
    status = "okay";
    bus-width = <8>;
    max-frequency = <25000000>;
    non-removable;
    disable-wp;
    vmmc-supply = <&emmc_vcc>;
    vqmmc-supply = <&emmc_vccq>;
};

&pio {
    vcc-pc-supply = <&emmc_vccq>;
    vcc-pg-supply = <&reg_bldo1>;
    vcc-ph-supply = <&emmc_vcc>;

    touch_i2c_pins: i2c0-ph-pins {
        pins = "PH0", "PH1";
        function = "i2c0";
        allwinner,pinmux = <2>;
        drive-strength = <10>;
        bias-pull-up;
    };
};

/* Leave hardware I2C disabled while the GPIO adapter owns PH0/PH1. */
&i2c0 {
    status = "disabled";
    clock-frequency = <100000>;
    pinctrl-names = "default";
    pinctrl-0 = <&touch_i2c_pins>;
    /delete-property/ dmas;
    /delete-property/ dma-names;
};

/* Keep polling while verifying the radio startup sequence. */
&mmc1 {
    status = "okay";
    bus-width = <4>;
    max-frequency = <25000000>;
    broken-cd;
    disable-wp;
    no-sd;
    no-mmc;
    vmmc-supply = <&reg_aldo3>;
    vqmmc-supply = <&reg_bldo1>;
    mmc-pwrseq = <&wifi_pwrseq>;
};

&uart0 { status = "okay"; };

&usb_otg {
    status = "okay";
    dr_mode = "peripheral";
};

&usbphy { status = "okay"; };

/* Preserve unspecified rail settings; claim only the tested peripheral rails. */
&r_i2c0 {
    status = "okay";
    clock-frequency = <100000>;
    /delete-property/ dmas;
    /delete-property/ dma-names;
    axp717: pmic@34 {
        compatible = "x-powers,axp717";
        reg = <0x34>;
        interrupt-controller;
        #interrupt-cells = <1>;
        interrupt-parent = <&nmi_intc>;
        interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
        regulators {
            reg_aldo3: aldo3 {
                regulator-name = "wifi-vcc";
                regulator-min-microvolt = <3300000>;
                regulator-max-microvolt = <3300000>;
            };
            reg_bldo1: bldo1 {
                regulator-name = "wifi-vcc-io-pg";
                regulator-min-microvolt = <1800000>;
                regulator-max-microvolt = <1800000>;
            };
            /* Confirmed by the chip ID appearing when enabled. */
            reg_cldo2: cldo2 {
                regulator-name = "touch-vcc";
                regulator-min-microvolt = <3300000>;
                regulator-max-microvolt = <3300000>;
                regulator-always-on;
            };
        };
    };
};
