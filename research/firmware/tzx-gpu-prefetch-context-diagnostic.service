[Unit]
Description=Manual GPU comparison with retained abort context
After=local-fs.target tzx-rtc-log.service
Wants=tzx-display.service

[Service]
Type=simple
Environment=TZX_GPU_TRACE_SCENES=1
Environment=TZX_GPU_EXPECT_AWAKE=1
ExecStart=/usr/bin/python3 /home/debian/run_prefetch_gpu_context_probe.py
ExecStopPost=/usr/bin/python3 /home/debian/finish_bl31_prefetch_gpu_trial.py
RuntimeMaxSec=780s
TimeoutStopSec=260s
