#!/bin/sh
set -eu
runtime=/usr/local/lib/tzx-peripherals
test "$(cat /sys/class/block/mmcblk0/device/cid)" = '3e01ff55454d20202010209170281b59'
case "${1:-}" in
start)
    cleanup() {
        ip link set wlan0 down 2>/dev/null || true
        rmmod aic8800_fdrv 2>/dev/null || true
        rmmod aic8800_bsp 2>/dev/null || true
        sh "$runtime/tzx-wifi-runtime-test.sh" stop || true
    }
    trap cleanup EXIT HUP INT TERM
    sh "$runtime/tzx-wifi-runtime-test.sh" start
    test "$(cat /sys/bus/sdio/devices/mmc1:390b:1/vendor)" = '0xc8a1'
    test "$(cat /sys/bus/sdio/devices/mmc1:390b:1/device)" = '0x0082'
    test "$(cat /sys/kernel/debug/mmc1/clock)" = '12000000'
    insmod "$runtime/aic8800_bsp.ko"
    insmod "$runtime/aic8800_fdrv.ko" aicwf_dbg_level=1 ps_on=0
    test -d /sys/class/net/wlan0
    # This board's OTP MAC reads as zero. Use a stable local address derived
    # from its exact eMMC CID instead of the driver's changing fallback.
    ip link set wlan0 address TZX_STABLE_MAC
    ip link set wlan0 up
    trap - EXIT HUP INT TERM
    echo TZX_WIFI_READY
    ;;
stop)
    ip link set wlan0 down
    rmmod aic8800_fdrv
    rmmod aic8800_bsp
    sh "$runtime/tzx-wifi-runtime-test.sh" stop
    ;;
*) exit 2;;
esac
