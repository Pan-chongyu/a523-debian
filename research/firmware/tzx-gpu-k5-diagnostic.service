[Unit]
Description=Bounded manual TZX A523 Mali DMA32 diagnostic on kernel #5
After=local-fs.target tzx-cpufreq.service
Wants=tzx-display.service

[Service]
Type=simple
ExecStartPre=/usr/bin/systemctl stop tzx-cpufreq.service
ExecStart=/usr/bin/python3 /home/debian/run_guarded_gpu_trial.py --label k5-aarch64 --aarch64-pgtable
ExecStopPost=/usr/bin/python3 /home/debian/finish_gpu_k5_trial.py
RuntimeMaxSec=780s
TimeoutStopSec=120s
