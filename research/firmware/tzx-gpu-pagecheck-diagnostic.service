[Unit]
Description=Bounded TZX A523 GPU trial with enforced page table checks
After=local-fs.target tzx-rtc-log.service
Requires=tzx-rtc-log.service
Wants=tzx-display.service

[Service]
Type=simple
Environment=TZX_GPU_TRACE_SCENES=1
Environment=TZX_GPU_EXPECT_AWAKE=1
Environment=TZX_GPU_DEBUG_STOPS=1
ExecStartPre=/usr/bin/python3 /usr/local/lib/tzx-rtc-log/runtime.py --live
ExecStartPre=/usr/bin/test ! -d /sys/module/tzx_cpufreq_divider
ExecStart=/usr/bin/python3 /home/debian/run_guarded_gpu_trial.py --label k6-pagecheck --aarch64-pgtable --keep-awake
ExecStopPost=/usr/bin/python3 /home/debian/finish_gpu_pagecheck_trial.py
RuntimeMaxSec=780s
TimeoutStopSec=120s
