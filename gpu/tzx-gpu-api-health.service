[Unit]
Description=TZX GPU API health recording with persistent fault evidence
After=tzx-gpu-performance.service tzx-emmc-hs.service tzx-screen-health.service
Wants=tzx-gpu-performance.service
ConditionPathExists=/usr/local/lib/tzx-gpu-api/health.py

[Service]
Type=notify
ExecStart=/usr/bin/python3 /usr/local/lib/tzx-gpu-api/health.py
Restart=on-failure
RestartSec=5
WatchdogSec=60
TimeoutStopSec=25
MemoryMax=64M
CPUWeight=10
StateDirectory=tzx-gpu-api-health
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/tzx-gpu-api-health /run

[Install]
WantedBy=multi-user.target
