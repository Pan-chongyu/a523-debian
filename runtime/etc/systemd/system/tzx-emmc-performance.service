[Unit]
Description=TZX exact-CID eMMC DDR52 50MHz with leased 25MHz fallback
ConditionKernelVersion=7.3.3-tzx-a523-accel1
ConditionPathExists=/var/lib/tzx/emmc-performance-qualified.json
Requires=tzx-thermal.service
After=tzx-dram-gpu-health.service tzx-screen-health.service tzx-cpu-performance.service tzx-gpu-performance.service

[Service]
Type=exec
ExecStart=/usr/bin/python3 -u /usr/local/lib/tzx-emmc-performance/runtime.py
ExecStopPost=/usr/bin/python3 -u /usr/local/lib/tzx-emmc-performance/cleanup.py
TimeoutStartSec=60
TimeoutStopSec=30
Restart=no

[Install]
WantedBy=graphical.target
